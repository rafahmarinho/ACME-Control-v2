# ACME Control API — copy to .env (local) or set in Vercel → Project → Settings → Environment Variables.

# Supabase project (Settings → API). The service-role key stays on the server only.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated list of allowed browser origins ("*" allows any origin; auth is via Bearer token).
ALLOWED_ORIGINS=http://localhost:8080,https://acme-control.vercel.app

# Demo accounts created by `pnpm seed:users`.
DEMO_PASSWORD=AcmeDemo!2026
DEMO_EMAIL_DOMAIN=acme-control.test

# Local dev server port (pnpm dev).
PORT=3001
